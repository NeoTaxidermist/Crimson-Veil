{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PROJECT_DIR\\Tools\\session-start.ps1\"",
            "timeout": 60,
            "statusMessage": "Stahuji změny z druhého počítače..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PROJECT_DIR\\Tools\\session-stop.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
