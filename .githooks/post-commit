#!/bin/sh
# Crimson Veil: commit dostane tag své verze (nejvyšší sekce v CHANGELOG.md).
ver=$(git show HEAD:CHANGELOG.md 2>/dev/null | sed -nE 's/^## \[([0-9]+\.[0-9]+\.[0-9]+)\] .* [0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]*$/\1/p' | head -n 1)
[ -n "$ver" ] || { echo "post-commit: v CHANGELOG.md není verze, commit zůstal bez tagu!" >&2; exit 0; }
if git rev-parse -q --verify "refs/tags/v$ver" >/dev/null; then
    [ "$(git rev-parse "v$ver^{commit}")" = "$(git rev-parse HEAD)" ] || echo "post-commit: tag v$ver už ukazuje jinam, commit zůstal bez tagu!" >&2
else
    git tag -a "v$ver" -m "v$ver" && echo "post-commit: tag v$ver"
fi
exit 0
