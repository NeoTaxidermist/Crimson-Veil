#!/bin/sh
# Crimson Veil: každý commit = nová verze + její sekce v CHANGELOG.md.
# Zapnutí (jednou na klon):  git config core.hooksPath .githooks
#                            git config push.followTags true

fail() {
    echo "pre-commit: $*" >&2
    echo "  Pravidlo projektu: každý commit má vlastní verzi a sekci '## [X.Y.Z] – RRRR-MM-DD' v CHANGELOG.md." >&2
    exit 1
}

top_version() { sed -nE 's/^## \[([0-9]+\.[0-9]+\.[0-9]+)\] .* [0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]*$/\1/p' | head -n 1; }

git diff --cached --name-only | grep -qx 'CHANGELOG.md' || fail "CHANGELOG.md není v commitu."

new_log=$(git show :CHANGELOG.md) || fail "CHANGELOG.md nejde přečíst."
ver=$(printf '%s\n' "$new_log" | top_version)
[ -n "$ver" ] || fail "v CHANGELOG.md chybí sekce verze '## [X.Y.Z] – RRRR-MM-DD'."

# Unreleased musí být prázdné: všechno patří pod číslo verze.
unreleased=$(printf '%s\n' "$new_log" | awk '/^## \[Unreleased\]/{on=1; next} /^## \[/{on=0} on && NF' | head -n 1)
[ -z "$unreleased" ] || fail "pod [Unreleased] je text ('$unreleased'); patří pod verzi $ver."

# Nová verze musí mít obsah.
body=$(printf '%s\n' "$new_log" | awk -v v="## [$ver]" 'index($0, v)==1{on=1; next} /^## \[/{on=0} on && NF' | head -n 1)
[ -n "$body" ] || fail "sekce [$ver] je prázdná."

if git rev-parse -q --verify HEAD >/dev/null; then
    old_ver=$(git show HEAD:CHANGELOG.md 2>/dev/null | top_version)
    if [ -n "$old_ver" ]; then
        [ "$ver" != "$old_ver" ] || fail "verze $ver už patří předchozímu commitu; přidej novou sekci (vyšší verzi)."
        highest=$(printf '%s\n%s\n' "$old_ver" "$ver" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)
        [ "$highest" = "$ver" ] || fail "verze $ver není vyšší než předchozí $old_ver."
    fi
    git show HEAD:CHANGELOG.md 2>/dev/null | grep -q "^## \[$ver\]" && fail "verze $ver už v CHANGELOGu byla."
fi
git rev-parse -q --verify "refs/tags/v$ver" >/dev/null && fail "tag v$ver už existuje."
exit 0
