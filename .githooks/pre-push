#!/bin/sh
# Crimson Veil: na GitHub nesmí odejít commit bez verze (tagu vX.Y.Z) a bez změny CHANGELOG.md.
remote="$1"
zero=0000000000000000000000000000000000000000
bad=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
    [ "$local_sha" = "$zero" ] && continue   # mazání větve
    if [ "$remote_sha" = "$zero" ]; then
        commits=$(git rev-list "$local_sha" --not --remotes="$remote")
    else
        commits=$(git rev-list "$remote_sha..$local_sha")
    fi
    for c in $commits; do
        short=$(git rev-parse --short "$c")
        if ! git tag --points-at "$c" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
            echo "pre-push: commit $short nemá tag verze vX.Y.Z." >&2; bad=1
        fi
        if [ "$(git rev-list --parents -n 1 "$c" | wc -w)" -le 2 ] &&
           ! git diff-tree --root --no-commit-id --name-only -r "$c" | grep -qx 'CHANGELOG.md'; then
            echo "pre-push: commit $short nemění CHANGELOG.md." >&2; bad=1
        fi
    done
done
if [ $bad -ne 0 ]; then
    echo "  Pravidlo projektu: každý commit má vlastní verzi a záznam v CHANGELOG.md. Push zastaven." >&2
    exit 1
fi
exit 0
